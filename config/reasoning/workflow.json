{
  "workspace_root": ".",
  "state_file": "runs/reasoning-challenger/workflow.json",
  "steps": [
    {
      "id": "audited_market_dataset", "stage": "audit",
      "job_config": "config/reasoning/market_job.json",
      "inputs": ["config/reasoning/development.json", "runs/reasoning-challenger/market-dataset/manifest.json", "runs/reasoning-challenger/market-dataset/audit.json", "runs/reasoning-challenger/market-dataset/train.jsonl", "runs/reasoning-challenger/market-dataset/valid.jsonl"],
      "outputs": ["runs/reasoning-challenger/market-dataset/audit.json"],
      "log": "runs/reasoning-challenger/logs/market-audit.log", "timeout_seconds": 300
    },
    {
      "id": "market_sft", "stage": "train",
      "job_config": "config/reasoning/market_job.json",
      "inputs": ["config/reasoning/development.json", "config/reasoning/market_sft.json", "config/reasoning/sft.json", "config/reasoning/defaults.json", "runs/reasoning-challenger/market-dataset/manifest.json", "runs/reasoning-challenger/market-dataset/audit.json", "runs/reasoning-challenger/market-dataset/train.jsonl", "runs/reasoning-challenger/market-dataset/valid.jsonl"],
      "outputs": ["runs/reasoning-challenger/market-adapters/adapter_config.json", "runs/reasoning-challenger/market-adapters/adapters.safetensors"],
      "log": "runs/reasoning-challenger/logs/market-sft.log", "timeout_seconds": 43200
    },
    {
      "id": "audited_dataset", "stage": "audit",
      "job_config": "config/reasoning/development.json",
      "inputs": ["runs/reasoning-challenger/dataset/manifest.json", "runs/reasoning-challenger/dataset/audit.json", "runs/reasoning-challenger/dataset/train.jsonl", "runs/reasoning-challenger/dataset/valid.jsonl"],
      "outputs": ["runs/reasoning-challenger/dataset/audit.json"],
      "log": "runs/reasoning-challenger/logs/audit.log", "timeout_seconds": 300
    },
    {
      "id": "sft", "stage": "train",
      "job_config": "config/reasoning/development.json",
      "inputs": ["config/reasoning/policy_sft.json", "config/reasoning/sft.json", "config/reasoning/defaults.json", "runs/reasoning-challenger/market-adapters/adapter_config.json", "runs/reasoning-challenger/market-adapters/adapters.safetensors", "runs/reasoning-challenger/dataset/manifest.json", "runs/reasoning-challenger/dataset/audit.json", "runs/reasoning-challenger/dataset/train.jsonl", "runs/reasoning-challenger/dataset/valid.jsonl"],
      "outputs": ["runs/reasoning-challenger/adapters/adapter_config.json", "runs/reasoning-challenger/adapters/adapters.safetensors"],
      "log": "runs/reasoning-challenger/logs/sft.log", "timeout_seconds": 43200
    },
    {
      "id": "rl", "stage": "rl",
      "job_config": "config/reasoning/development.json",
      "inputs": ["config/reasoning/rl.json", "config/reasoning/policy_sft.json", "config/reasoning/sft.json", "config/reasoning/defaults.json", "config/reasoning/context.json", "runs/reasoning-challenger/adapters/adapter_config.json", "runs/reasoning-challenger/adapters/adapters.safetensors"],
      "outputs": ["runs/reasoning-challenger/rl-adapters/adapter_config.json", "runs/reasoning-challenger/rl-adapters/adapters.safetensors", "runs/reasoning-challenger/rl-adapters/rl_receipt.json"],
      "log": "runs/reasoning-challenger/logs/rl.log", "timeout_seconds": 43200
    },
    {
      "id": "evaluation", "stage": "evaluate",
      "job_config": "config/reasoning/development.json",
      "inputs": ["config/reasoning/evaluation.json", "config/reasoning/evaluation_metrics.json", "config/reasoning/policy_sft.json", "config/reasoning/sft.json", "config/reasoning/defaults.json", "config/reasoning/context.json", "runs/reasoning-challenger/rl-adapters/adapters.safetensors", "runs/reasoning-challenger/rl-adapters/adapter_config.json"],
      "outputs": ["runs/reasoning-challenger/evaluation.json", "runs/reasoning-challenger/evaluation-decisions.jsonl"],
      "log": "runs/reasoning-challenger/logs/evaluation.log", "timeout_seconds": 43200
    }
  ]
}
