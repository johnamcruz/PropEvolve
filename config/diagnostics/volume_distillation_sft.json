{
  "inherits": "../reasoning/qwen3_0_6b_market_probability_sft.json",
  "data": "runs/reasoning-challenger/volume-ab/market-corpus",
  "adapter_path": "runs/reasoning-challenger/volume-ab/market-adapter",
  "resume_adapter_file": "runs/reasoning-challenger/market-distillation-candidate/action/adapters.safetensors",
  "resume_adapter_requirements": {
    "input_mode": "embeddings",
    "decision_objective": "hierarchical_binary",
    "action_supervision": {
      "enabled": true,
      "soft_target_weight": 0.5,
      "ranking_weight": 2.0,
      "margin": 0.1
    }
  },
  "projector": {
    "embedding_dim": 2560,
    "context_steps": 20,
    "market_tokens": 5,
    "temporal_encoding": "latest_plus_deltas",
    "state_fields": [
      "trade.open",
      "trade.position_side",
      "trade.risk_available",
      "trade.mfe_r_so_far",
      "trade.mae_r_so_far",
      "trade.current_r",
      "trade.giveback_r",
      "trade.hold_bars"
    ],
    "state_scales": [1.0, 1.0, 1.0, 4.0, 4.0, 4.0, 4.0, 150.0]
  },
  "prepared_state_defaults": {
    "trade.open": 0.0,
    "trade.position_side": 0.0,
    "trade.risk_available": 0.0,
    "trade.mfe_r_so_far": 0.0,
    "trade.mae_r_so_far": 0.0,
    "trade.current_r": 0.0,
    "trade.giveback_r": 0.0,
    "trade.hold_bars": 0.0
  },
  "epochs": 3,
  "prepared_sampling": {
    "fields": ["ticker", "year"],
    "rows_per_stratum": {"train": 4, "valid": 4},
    "seed": 17
  },
  "steps_per_report": 14,
  "steps_per_eval": 28,
  "save_every": 28,
  "save_training_state": false,
  "training_log_prefix": "volume-market-distillation"
}
