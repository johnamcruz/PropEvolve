{
  "inherits": "../reasoning/qwen3_0_6b_market_probability_sft.json",
  "data": "runs/reasoning-challenger/volume-ab/market-corpus",
  "adapter_path": "runs/reasoning-challenger/volume-ab/market-adapter",
  "resume_adapter_file": "runs/reasoning-challenger/market-distillation-candidate/action/adapters.safetensors",
  "resume_adapter_requirements": {
    "input_mode": "embeddings",
    "decision_objective": "hierarchical_binary",
    "action_supervision": {
      "enabled": true,
      "soft_target_weight": 0.5,
      "ranking_weight": 2.0,
      "margin": 0.1
    }
  },
  "epochs": 3,
  "prepared_sampling": {
    "fields": ["ticker", "year"],
    "rows_per_stratum": {"train": 4, "valid": 4},
    "seed": 17
  },
  "steps_per_report": 14,
  "steps_per_eval": 28,
  "save_every": 28,
  "save_training_state": false,
  "training_log_prefix": "volume-market-distillation"
}
