{
  "workspace_root": ".",
  "state_file": "runs/reasoning-challenger/volume-ab/workflow-state.json",
  "steps": [
    {
      "id": "distill_expansion_trend_regime_volume",
      "stage": "train",
      "job_config": "config/diagnostics/volume_distillation_job.json",
      "inputs": [
        "runs/reasoning-challenger/volume-ab/market-corpus/manifest.json",
        "runs/reasoning-challenger/volume-ab/market-corpus/audit.json",
        "runs/reasoning-challenger/volume-ab/market-view/view_manifest.json",
        "runs/reasoning-challenger/market-distillation-candidate/action/adapter_config.json",
        "runs/reasoning-challenger/market-distillation-candidate/action/adapters.safetensors",
        "runs/reasoning-challenger/market-distillation-candidate/action/projector.safetensors"
      ],
      "outputs": [
        "runs/reasoning-challenger/volume-ab/market-adapter/adapter_config.json",
        "runs/reasoning-challenger/volume-ab/market-adapter/adapters.safetensors",
        "runs/reasoning-challenger/volume-ab/market-adapter/projector.safetensors",
        "runs/reasoning-challenger/volume-ab/market-adapter/training_selection.json"
      ],
      "log": "runs/reasoning-challenger/volume-ab/market-training-controller.log",
      "timeout_seconds": 43200
    },
    {
      "id": "correct_authenticated_action_mistakes",
      "stage": "corrective",
      "job_config": "config/diagnostics/volume_corrective_campaign.json",
      "inputs": [
        "runs/reasoning-challenger/volume-ab/market-adapter/adapter_config.json",
        "runs/reasoning-challenger/volume-ab/market-adapter/adapters.safetensors",
        "runs/reasoning-challenger/volume-ab/market-adapter/projector.safetensors",
        "runs/reasoning-challenger/trade-inference-assessment/view/view_manifest.json",
        "runs/reasoning-challenger/trade-inference-assessment/train-assessment/scores.jsonl",
        "runs/reasoning-challenger/trade-inference-assessment/train-assessment/summary.json",
        "runs/reasoning-challenger/corrective-trade-mastery/round-01/parent-valid-assessment/scores.jsonl",
        "runs/reasoning-challenger/corrective-trade-mastery/round-01/parent-valid-assessment/summary.json"
      ],
      "outputs": [
        "runs/reasoning-challenger/volume-ab/corrective/campaign-state.json"
      ],
      "log": "runs/reasoning-challenger/volume-ab/corrective-controller.log",
      "timeout_seconds": 172800
    }
  ]
}
